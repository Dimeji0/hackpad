{
    "manufacturer": "Mairo",
    "keyboard_name": "personalhackpad",
    "maintainer": "Dimeji0",
    "bootloader": "rp2040",
    "diode_direction": "COL2ROW",
    "features": {
        "bootmagic": true,
        "extrakey": true,
        "mousekey": true,
        "nkro": true
    },
    "matrix_pins": {
       "direct": [
            ["GP26", "GP27", "GP28", "GP29"]
        ]
    },
    "processor": "RP2040",
    "url": "https://github.com/Dimeji0/hackpad",
    "usb": {
        "device_version": "1.0.0",
        "pid": "0x0000",
        "vid": "0xFEED"
    },
     "encoder": {
        "rotary": [
            {"pin_a": "GP2", "pin_b": "GP4", "resolution": 4}
        ]
    },
    "layouts": {
        "LAYOUT": {
            "layout": [
                 {"label": "SW1 (Top)", "matrix":[0,0], "x": 0, "y": 0},
                {"label": "SW2 (Mid)", "matrix":[0,1], "x": 0, "y": 1},
                {"label": "SW3 (Bot)", "matrix":[0,2], "x": 0, "y": 2},
                {"label": "Encoder Switch", "matrix":[0,3], "x": 1, "y": 1}
            ]
        }
    }
}